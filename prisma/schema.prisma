// Modelo de datos — Fase 1
//
// Principios:
// - Un User es una identidad (credenciales + datos personales mínimos).
// - Los roles viven en una tabla aparte (UserRole): una persona puede ser
//   paciente y, más adelante, también médico, sin duplicar cuentas.
// - Los datos de cada rol viven en su propio perfil (PatientProfile,
//   DoctorProfile) para poder aislar permisos por tipo de dato.
// - DoctorVerification es un historial inmutable de decisiones de verificación.
// - Las sesiones y tokens de recuperación se guardan sólo como hash.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DoctorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

model User {
  id              String     @id @default(cuid())
  /// Siempre normalizado a minúsculas.
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles               UserRole[]           @relation("UserRoles")
  rolesGranted        UserRole[]           @relation("RoleGrantedBy")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  verificationReviews DoctorVerification[] @relation("VerificationReviewer")

  // Autoría de información médica (Fase 2)
  createdRecords      MedicalRecord[]   @relation("RecordCreatedBy")
  uploadedFiles       MedicalFile[]     @relation("FileUploadedBy")
  createdAllergies    Allergy[]         @relation("AllergyCreatedBy")
  createdConditions   Condition[]       @relation("ConditionCreatedBy")
  createdMedications  Medication[]      @relation("MedicationCreatedBy")
  createdSurgeries    Surgery[]         @relation("SurgeryCreatedBy")
  createdHospitals    Hospitalization[] @relation("HospitalizationCreatedBy")
  createdVaccinations Vaccination[]     @relation("VaccinationCreatedBy")
  createdFamilyItems  FamilyHistory[]   @relation("FamilyHistoryCreatedBy")

  @@map("users")
}

model UserRole {
  id          String   @id @default(cuid())
  userId      String
  role        Role
  grantedAt   DateTime @default(now())
  /// Null cuando el rol se obtuvo por autoregistro o seed.
  grantedById String?

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  dateOfBirth DateTime? @db.Date
  sex         Sex?
  /// DNI u otro documento de identidad.
  documentId  String?
  phone       String?
  province    String?
  city        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Información médica (Fase 2). Todo cuelga del paciente: la propiedad se verifica por patientId.
  healthProfile     HealthProfile?
  emergencyProfile  EmergencyProfile?
  emergencyContacts EmergencyContact[]
  allergies         Allergy[]
  conditions        Condition[]
  medications       Medication[]
  surgeries         Surgery[]
  hospitalizations  Hospitalization[]
  vaccinations      Vaccination[]
  familyHistory     FamilyHistory[]
  institutions      Institution[]
  records           MedicalRecord[]
  files             MedicalFile[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  specialty          String
  licenseNumber      String
  /// Código de jurisdicción que emitió la matrícula (ver src/lib/jurisdictions.ts).
  jurisdiction       String
  verificationStatus DoctorVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications DoctorVerification[]

  @@unique([jurisdiction, licenseNumber])
  @@index([verificationStatus])
  @@map("doctor_profiles")
}

/// Historial (append-only) de eventos de verificación de un médico.
model DoctorVerification {
  id              String                   @id @default(cuid())
  doctorProfileId String
  status          DoctorVerificationStatus
  /// Motivo / nota del revisor (obligatorio al rechazar).
  note            String?
  /// Null cuando el evento lo genera el sistema (p. ej. la solicitud inicial).
  reviewerId      String?
  createdAt       DateTime                 @default(now())

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  reviewer      User?         @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([doctorProfileId, createdAt])
  @@map("doctor_verifications")
}

model Session {
  /// SHA-256 del token de sesión. El token en claro sólo existe en la cookie.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 del token enviado por email.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// FASE 2 — Información médica del paciente
//
// - Toda entidad clínica pertenece a un PatientProfile (patientId) y registra su
//   ORIGEN (source: PATIENT | DOCTOR | SYSTEM) y AUTOR (createdById). En esta fase
//   el paciente carga casi todo; en la próxima los médicos autorizados podrán crear
//   registros con source = DOCTOR sin cambiar el modelo.
// - Los archivos nunca son públicos: MedicalFile guarda sólo metadatos y una
//   storageKey aleatoria; los bytes se sirven a través de /api/files/[id], que
//   valida sesión, propiedad y permisos en cada request.
// ─────────────────────────────────────────────────────────────────────────────

enum DataSource {
  PATIENT
  DOCTOR
  SYSTEM
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum ConditionStatus {
  ACTIVE
  RESOLVED
}

/// Categorías de registros médicos. Extensibles: se agregan filas sin migrar código.
model MedicalCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  records MedicalRecord[]

  @@map("medical_categories")
}

/// Instituciones de salud. En esta fase son propias de cada paciente (texto que él carga),
/// para no exponer a otros pacientes dónde se atiende alguien. Un catálogo global
/// verificado puede agregarse más adelante.
model Institution {
  id             String   @id @default(cuid())
  patientId      String
  name           String
  /// Nombre normalizado (minúsculas, sin acentos) para deduplicar.
  normalizedName String
  createdAt      DateTime @default(now())

  patient          PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  records          MedicalRecord[]
  surgeries        Surgery[]
  hospitalizations Hospitalization[]

  @@unique([patientId, normalizedName])
  @@map("institutions")
}

/// Datos biométricos básicos (1:1 con el paciente).
model HealthProfile {
  id        String     @id @default(cuid())
  patientId String     @unique
  bloodType BloodType?
  heightCm  Int?
  weightKg  Float?
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

/// Qué información el paciente elige mostrar en su ficha de emergencia.
model EmergencyProfile {
  id                    String   @id @default(cuid())
  patientId             String   @unique
  showBloodType         Boolean  @default(true)
  showAllergies         Boolean  @default(true)
  showConditions        Boolean  @default(true)
  showMedications       Boolean  @default(true)
  showEmergencyContacts Boolean  @default(true)
  additionalNotes       String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_profiles")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  patientId    String
  name         String
  relationship String?
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("emergency_contacts")
}

model Allergy {
  id          String          @id @default(cuid())
  patientId   String
  name        String
  severity    AllergySeverity @default(UNKNOWN)
  reaction    String?
  source      DataSource      @default(PATIENT)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("AllergyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("allergies")
}

model Condition {
  id          String          @id @default(cuid())
  patientId   String
  name        String
  status      ConditionStatus @default(ACTIVE)
  diagnosedOn DateTime?       @db.Date
  notes       String?
  source      DataSource      @default(PATIENT)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("ConditionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("conditions")
}

model Medication {
  id          String     @id @default(cuid())
  patientId   String
  name        String
  dosage      String?
  frequency   String?
  startedOn   DateTime?  @db.Date
  notes       String?
  source      DataSource @default(PATIENT)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("MedicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("medications")
}

model Surgery {
  id            String     @id @default(cuid())
  patientId     String
  name          String
  performedOn   DateTime?  @db.Date
  institutionId String?
  notes         String?
  source        DataSource @default(PATIENT)
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  institution Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("SurgeryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("surgeries")
}

model Hospitalization {
  id            String     @id @default(cuid())
  patientId     String
  reason        String
  admittedOn    DateTime?  @db.Date
  dischargedOn  DateTime?  @db.Date
  institutionId String?
  notes         String?
  source        DataSource @default(PATIENT)
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  institution Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("HospitalizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("hospitalizations")
}

model Vaccination {
  id             String     @id @default(cuid())
  patientId      String
  name           String
  dose           String?
  administeredOn DateTime?  @db.Date
  notes          String?
  source         DataSource @default(PATIENT)
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("VaccinationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("vaccinations")
}

model FamilyHistory {
  id           String     @id @default(cuid())
  patientId    String
  relationship String
  condition    String
  notes        String?
  source       DataSource @default(PATIENT)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("FamilyHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("family_history")
}

/// Un hecho médico fechado: estudio, consulta, informe, receta… Puede tener 0..n archivos.
/// Es la unidad del historial cronológico y de la búsqueda.
model MedicalRecord {
  id               String     @id @default(cuid())
  patientId        String
  title            String
  occurredOn       DateTime   @db.Date
  categoryId       String
  specialty        String?
  institutionId    String?
  professionalName String?
  description      String?
  /// Normalizados a minúsculas.
  tags             String[]   @default([])
  /// Texto normalizado (minúsculas, sin acentos) con todos los campos buscables.
  searchText       String     @default("")
  source           DataSource @default(PATIENT)
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  patient     PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category    MedicalCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  institution Institution?    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("RecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  files       MedicalFile[]

  @@index([patientId, occurredOn])
  @@index([patientId, categoryId])
  @@map("medical_records")
}

/// Metadatos de un archivo privado. Los bytes viven en el storage (local o S3) bajo storageKey.
model MedicalFile {
  id           String   @id @default(cuid())
  /// Denormalizado desde el registro para validar propiedad sin joins.
  patientId    String
  recordId     String
  /// Clave aleatoria en el storage. Nunca contiene datos del paciente ni el nombre original.
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedById String?
  createdAt    DateTime @default(now())

  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  record     MedicalRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  uploadedBy User?          @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([recordId])
  @@map("medical_files")
}
