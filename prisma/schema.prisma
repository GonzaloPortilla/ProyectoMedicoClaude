// Modelo de datos — Fase 1
//
// Principios:
// - Un User es una identidad (credenciales + datos personales mínimos).
// - Los roles viven en una tabla aparte (UserRole): una persona puede ser
//   paciente y, más adelante, también médico, sin duplicar cuentas.
// - Los datos de cada rol viven en su propio perfil (PatientProfile,
//   DoctorProfile) para poder aislar permisos por tipo de dato.
// - DoctorVerification es un historial inmutable de decisiones de verificación.
// - Las sesiones y tokens de recuperación se guardan sólo como hash.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DoctorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Sex {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

model User {
  id              String     @id @default(cuid())
  /// Siempre normalizado a minúsculas.
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Seguridad (Fase 4)
  /// Intentos fallidos consecutivos (se reinicia con un login exitoso).
  failedLoginCount  Int       @default(0)
  /// Bloqueo temporal por fuerza bruta.
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  /// Secreto TOTP cifrado (AES-256-GCM). null = MFA no configurada.
  mfaSecretEnc      String?
  mfaEnabledAt      DateTime?
  /// Último paso de tiempo TOTP aceptado (evita reutilizar un código).
  mfaLastUsedStep   Int?

  roles               UserRole[]           @relation("UserRoles")
  rolesGranted        UserRole[]           @relation("RoleGrantedBy")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  verificationReviews DoctorVerification[] @relation("VerificationReviewer")

  // Autoría de información médica (Fase 2)
  createdRecords        MedicalRecord[]      @relation("RecordCreatedBy")
  uploadedFiles         MedicalFile[]        @relation("FileUploadedBy")
  reviewedExtractions   DocumentExtraction[] @relation("ExtractionReviewedBy")
  confirmedMeasurements MedicalMeasurement[] @relation("MeasurementConfirmedBy")
  verifiedMeasurements  MedicalMeasurement[] @relation("MeasurementVerifiedBy")
  createdAllergies      Allergy[]            @relation("AllergyCreatedBy")
  createdConditions     Condition[]          @relation("ConditionCreatedBy")
  createdMedications    Medication[]         @relation("MedicationCreatedBy")
  createdSurgeries      Surgery[]            @relation("SurgeryCreatedBy")
  createdHospitals      Hospitalization[]    @relation("HospitalizationCreatedBy")
  createdVaccinations   Vaccination[]        @relation("VaccinationCreatedBy")
  createdFamilyItems    FamilyHistory[]      @relation("FamilyHistoryCreatedBy")

  // Acceso médico (Fase 3)
  accessRequests          AccessRequest[]          @relation("DoctorRequests")
  accessGrants            AccessGrant[]            @relation("DoctorGrants")
  emailVerificationTokens EmailVerificationToken[]
  mfaRecoveryCodes        MfaRecoveryCode[]
  usedLinkCodes           PatientLinkCode[]        @relation("LinkCodeUsedBy")
  reportsAuthored         MedicalReport[]          @relation("ReportAuthor")
  reportVersions          MedicalReportVersion[]   @relation("ReportVersionAuthor")

  @@map("users")
}

model UserRole {
  id          String   @id @default(cuid())
  userId      String
  role        Role
  grantedAt   DateTime @default(now())
  /// Null cuando el rol se obtuvo por autoregistro o seed.
  grantedById String?

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  dateOfBirth DateTime? @db.Date
  sex         Sex?
  /// DNI u otro documento de identidad.
  documentId  String?
  phone       String?
  province    String?
  city        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Información médica (Fase 2). Todo cuelga del paciente: la propiedad se verifica por patientId.
  healthProfile     HealthProfile?
  emergencyProfile  EmergencyProfile?
  emergencyContacts EmergencyContact[]
  allergies         Allergy[]
  conditions        Condition[]
  medications       Medication[]
  surgeries         Surgery[]
  hospitalizations  Hospitalization[]
  vaccinations      Vaccination[]
  familyHistory     FamilyHistory[]
  institutions      Institution[]
  records           MedicalRecord[]
  files             MedicalFile[]
  extractions       DocumentExtraction[]
  measurements      MedicalMeasurement[]

  // Acceso médico (Fase 3)
  linkCodes      PatientLinkCode[]
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]
  reports        MedicalReport[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  specialty          String
  licenseNumber      String
  /// Código de jurisdicción que emitió la matrícula (ver src/lib/jurisdictions.ts).
  jurisdiction       String
  verificationStatus DoctorVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications DoctorVerification[]

  @@unique([jurisdiction, licenseNumber])
  @@index([verificationStatus])
  @@map("doctor_profiles")
}

/// Historial (append-only) de eventos de verificación de un médico.
model DoctorVerification {
  id              String                   @id @default(cuid())
  doctorProfileId String
  status          DoctorVerificationStatus
  /// Motivo / nota del revisor (obligatorio al rechazar).
  note            String?
  /// Null cuando el evento lo genera el sistema (p. ej. la solicitud inicial).
  reviewerId      String?
  createdAt       DateTime                 @default(now())

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  reviewer      User?         @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([doctorProfileId, createdAt])
  @@map("doctor_verifications")
}

model Session {
  /// SHA-256 del token de sesión. El token en claro sólo existe en la cookie.
  id          String   @id
  /// Identificador no secreto para listar y cerrar sesiones desde la interfaz.
  publicId    String   @unique @default(cuid())
  userId      String
  /// Vencimiento absoluto.
  expiresAt   DateTime
  /// Última actividad (para el vencimiento por inactividad).
  lastSeenAt  DateTime @default(now())
  /// La sesión pasó el segundo factor (o el usuario no tiene MFA).
  mfaVerified Boolean  @default(false)
  createdAt   DateTime @default(now())
  /// IP anonimizada (último octeto / últimos 80 bits en cero).
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 del token enviado por email.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// FASE 2 — Información médica del paciente
//
// - Toda entidad clínica pertenece a un PatientProfile (patientId) y registra su
//   ORIGEN (source: PATIENT | DOCTOR | SYSTEM) y AUTOR (createdById). En esta fase
//   el paciente carga casi todo; en la próxima los médicos autorizados podrán crear
//   registros con source = DOCTOR sin cambiar el modelo.
// - Los archivos nunca son públicos: MedicalFile guarda sólo metadatos y una
//   storageKey aleatoria; los bytes se sirven a través de /api/files/[id], que
//   valida sesión, propiedad y permisos en cada request.
// ─────────────────────────────────────────────────────────────────────────────

enum DataSource {
  PATIENT
  DOCTOR
  SYSTEM
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum ConditionStatus {
  ACTIVE
  RESOLVED
}

/// Categorías de registros médicos. Extensibles: se agregan filas sin migrar código.
model MedicalCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  records MedicalRecord[]

  @@map("medical_categories")
}

/// Instituciones de salud. En esta fase son propias de cada paciente (texto que él carga),
/// para no exponer a otros pacientes dónde se atiende alguien. Un catálogo global
/// verificado puede agregarse más adelante.
model Institution {
  id             String   @id @default(cuid())
  patientId      String
  name           String
  /// Nombre normalizado (minúsculas, sin acentos) para deduplicar.
  normalizedName String
  createdAt      DateTime @default(now())

  patient          PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  records          MedicalRecord[]
  surgeries        Surgery[]
  hospitalizations Hospitalization[]
  measurements     MedicalMeasurement[]

  @@unique([patientId, normalizedName])
  @@map("institutions")
}

/// Datos biométricos básicos (1:1 con el paciente).
model HealthProfile {
  id        String     @id @default(cuid())
  patientId String     @unique
  bloodType BloodType?
  heightCm  Int?
  weightKg  Float?
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

/// Qué información el paciente elige mostrar en su ficha de emergencia.
model EmergencyProfile {
  id                    String   @id @default(cuid())
  patientId             String   @unique
  showBloodType         Boolean  @default(true)
  showAllergies         Boolean  @default(true)
  showConditions        Boolean  @default(true)
  showMedications       Boolean  @default(true)
  showEmergencyContacts Boolean  @default(true)
  additionalNotes       String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_profiles")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  patientId    String
  name         String
  relationship String?
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("emergency_contacts")
}

model Allergy {
  id          String          @id @default(cuid())
  patientId   String
  name        String
  severity    AllergySeverity @default(UNKNOWN)
  reaction    String?
  source      DataSource      @default(PATIENT)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("AllergyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("allergies")
}

model Condition {
  id          String          @id @default(cuid())
  patientId   String
  name        String
  status      ConditionStatus @default(ACTIVE)
  diagnosedOn DateTime?       @db.Date
  notes       String?
  source      DataSource      @default(PATIENT)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("ConditionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("conditions")
}

model Medication {
  id          String     @id @default(cuid())
  patientId   String
  name        String
  dosage      String?
  frequency   String?
  startedOn   DateTime?  @db.Date
  notes       String?
  source      DataSource @default(PATIENT)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("MedicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("medications")
}

model Surgery {
  id            String     @id @default(cuid())
  patientId     String
  name          String
  performedOn   DateTime?  @db.Date
  institutionId String?
  notes         String?
  source        DataSource @default(PATIENT)
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  institution Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("SurgeryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("surgeries")
}

model Hospitalization {
  id            String     @id @default(cuid())
  patientId     String
  reason        String
  admittedOn    DateTime?  @db.Date
  dischargedOn  DateTime?  @db.Date
  institutionId String?
  notes         String?
  source        DataSource @default(PATIENT)
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  institution Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("HospitalizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("hospitalizations")
}

model Vaccination {
  id             String     @id @default(cuid())
  patientId      String
  name           String
  dose           String?
  administeredOn DateTime?  @db.Date
  notes          String?
  source         DataSource @default(PATIENT)
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("VaccinationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("vaccinations")
}

model FamilyHistory {
  id           String     @id @default(cuid())
  patientId    String
  relationship String
  condition    String
  notes        String?
  source       DataSource @default(PATIENT)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("FamilyHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("family_history")
}

/// Un hecho médico fechado: estudio, consulta, informe, receta… Puede tener 0..n archivos.
/// Es la unidad del historial cronológico y de la búsqueda.
model MedicalRecord {
  id               String     @id @default(cuid())
  patientId        String
  title            String
  occurredOn       DateTime   @db.Date
  categoryId       String
  specialty        String?
  institutionId    String?
  professionalName String?
  description      String?
  /// Normalizados a minúsculas.
  tags             String[]   @default([])
  /// Texto normalizado (minúsculas, sin acentos) con todos los campos buscables.
  searchText       String     @default("")
  source           DataSource @default(PATIENT)
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  patient      PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category     MedicalCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  institution  Institution?         @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("RecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  files        MedicalFile[]
  /// Presente cuando el registro es un informe médico versionado.
  report       MedicalReport?
  extractions  DocumentExtraction[]
  measurements MedicalMeasurement[]

  @@index([patientId, occurredOn])
  @@index([patientId, categoryId])
  @@map("medical_records")
}

/// Metadatos de un archivo privado. Los bytes viven en el storage (local o S3) bajo storageKey.
model MedicalFile {
  id             String   @id @default(cuid())
  /// Denormalizado desde el registro para validar propiedad sin joins.
  patientId      String
  recordId       String
  /// Clave aleatoria en el storage. Nunca contiene datos del paciente ni el nombre original.
  storageKey     String   @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  /// SHA-256 de lo almacenado (después de quitar metadatos EXIF/GPS de las imágenes).
  sha256         String
  /// SHA-256 de los bytes tal como los subió el usuario. Detecta archivos ya cargados.
  originalSha256 String?
  uploadedById   String?
  createdAt      DateTime @default(now())

  patient      PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  record       MedicalRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  uploadedBy   User?                @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  extraction   DocumentExtraction?
  measurements MedicalMeasurement[]

  @@index([patientId])
  @@index([recordId])
  @@index([patientId, originalSha256])
  @@index([patientId, sha256])
  @@map("medical_files")
}

// ─────────────────────────────────────────────────────────────────────────────
// FASE 3 — Acceso de médicos con autorización explícita del paciente
//
// Flujo: el paciente genera un código de un solo uso → el médico (verificado) lo
// ingresa y crea una AccessRequest → el paciente la acepta eligiendo qué compartir
// y por cuánto tiempo → se crea un AccessGrant con N AccessPermission
// (tipo de recurso + clave + acción). El paciente puede revocarlo en cualquier momento.
//
// Un grant sólo es válido si: status = ACTIVE, revokedAt = null,
// expiresAt es null (permanente) o futura, y el médico sigue VERIFICADO.
// Esto se evalúa en CADA request (src/server/access/policy.ts); no hay caché.
// ─────────────────────────────────────────────────────────────────────────────

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AccessGrantStatus {
  ACTIVE
  REVOKED
  SUPERSEDED
  /// Venció por tiempo (lo marca el barrido de vencimientos; la política ya lo bloquea antes).
  EXPIRED
}

/// Tipo de recurso sobre el que se otorga un permiso. Extensible.
enum AccessResourceType {
  /// Una sección de "Mi salud" (GENERAL, ALLERGIES, CONDITIONS, MEDICATIONS, FAMILY_HISTORY).
  HEALTH_SECTION
  /// Una categoría de registros médicos (slug de MedicalCategory).
  RECORD_CATEGORY
}

/// Acción permitida. Extensible.
enum AccessAction {
  VIEW
  UPLOAD
  CREATE_MEDICAL_ENTRY
}

/// Código de vinculación de un solo uso que el paciente comparte con su médico.
model PatientLinkCode {
  id           String    @id @default(cuid())
  patientId    String
  /// SHA-256 del código. El código en claro sólo lo ve el paciente.
  codeHash     String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  createdAt    DateTime  @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  usedBy  User?          @relation("LinkCodeUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("patient_link_codes")
}

model AccessRequest {
  id                 String              @id @default(cuid())
  patientId          String
  doctorUserId       String
  status             AccessRequestStatus @default(PENDING)
  message            String?
  /// Recursos que el médico sugiere (p. ej. "RECORD_CATEGORY:cardiologia"). El paciente decide.
  requestedResources String[]            @default([])
  expiresAt          DateTime
  respondedAt        DateTime?
  createdAt          DateTime            @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User           @relation("DoctorRequests", fields: [doctorUserId], references: [id], onDelete: Cascade)
  grant   AccessGrant?

  @@index([patientId, status])
  @@index([doctorUserId, status])
  @@map("access_requests")
}

model AccessGrant {
  id           String            @id @default(cuid())
  patientId    String
  doctorUserId String
  requestId    String?           @unique
  status       AccessGrantStatus @default(ACTIVE)
  startsAt     DateTime          @default(now())
  /// null = permanente (hasta que el paciente lo revoque).
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())

  patient     PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User               @relation("DoctorGrants", fields: [doctorUserId], references: [id], onDelete: Cascade)
  request     AccessRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  permissions AccessPermission[]

  @@index([doctorUserId, status])
  @@index([patientId, status])
  @@map("access_grants")
}

/// paciente + médico (vía grant) + recurso + acción. Duración: la del grant.
model AccessPermission {
  id           String             @id @default(cuid())
  grantId      String
  resourceType AccessResourceType
  resourceKey  String
  action       AccessAction

  grant AccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([grantId, resourceType, resourceKey, action])
  @@map("access_permissions")
}

/// Informe médico creado por un médico autorizado. Se muestra en el historial a través de su MedicalRecord.
/// Los datos del autor se guardan como snapshot (pueden cambiar luego en su perfil).
model MedicalReport {
  id                  String   @id @default(cuid())
  recordId            String   @unique
  patientId           String
  authorUserId        String?
  authorName          String
  licenseNumber       String
  licenseJurisdiction String
  specialty           String
  currentVersion      Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  record   MedicalRecord          @relation(fields: [recordId], references: [id], onDelete: Restrict)
  patient  PatientProfile         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author   User?                  @relation("ReportAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  versions MedicalReportVersion[]

  @@index([patientId])
  @@map("medical_reports")
}

/// Versión de un informe. APPEND-ONLY: la base de datos rechaza UPDATE y DELETE (trigger).
/// Una corrección crea una versión nueva y conserva las anteriores.
model MedicalReportVersion {
  id            String   @id @default(cuid())
  reportId      String
  version       Int
  title         String
  content       String
  /// Motivo de la corrección (null en la versión 1).
  changeReason  String?
  contentSha256 String
  createdById   String?
  createdAt     DateTime @default(now())

  report    MedicalReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("ReportVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([reportId, version])
  @@map("medical_report_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// FASE 4 — Seguridad, auditoría y privacidad
// ─────────────────────────────────────────────────────────────────────────────

enum AuditAction {
  // Autenticación y cuenta
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  SESSION_REVOKED
  MFA_CHALLENGE_FAILED
  MFA_ENABLED
  MFA_DISABLED
  MFA_RECOVERY_CODE_USED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  ACCOUNT_REGISTERED
  PROFILE_UPDATED
  DATA_EXPORTED
  // Información médica
  RECORD_CREATED
  RECORD_DELETED
  RECORD_VIEWED
  FILE_VIEWED
  FILE_DOWNLOADED
  HEALTH_ENTRY_CREATED
  HEALTH_ENTRY_DELETED
  EMERGENCY_SETTINGS_UPDATED
  // Acceso de médicos
  LINK_CODE_CREATED
  ACCESS_REQUESTED
  ACCESS_REQUEST_CANCELLED
  ACCESS_GRANTED
  ACCESS_REJECTED
  ACCESS_REVOKED
  ACCESS_EXPIRED
  ACCESS_DENIED
  PATIENT_SUMMARY_VIEWED
  REPORT_CREATED
  REPORT_CORRECTED
  // Procesamiento de estudios (Fase 6)
  DOCUMENT_PROCESSED
  DOCUMENT_REVIEWED
  MEASUREMENTS_REVIEWED
  MEASUREMENTS_VIEWED
  // Administración
  DOCTOR_VERIFICATION_DECIDED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum AuditActorType {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
  ANONYMOUS
}

/// Registro de auditoría APPEND-ONLY y encadenado.
///
/// - Sin claves foráneas: el registro sobrevive aunque se borre el usuario o el recurso,
///   y ninguna cascada puede modificarlo.
/// - La base rechaza UPDATE, DELETE y TRUNCATE (triggers).
/// - Cada fila guarda el hash de la anterior (prevHash) y el propio (hash), calculados por
///   un trigger: alterar o borrar una fila rompe la cadena y `npm run audit:verify` lo detecta.
/// - Minimización: nunca se guardan contenidos clínicos, contraseñas, tokens ni nombres de
///   archivo; sólo identificadores y metadatos no sensibles.
model AuditEvent {
  id               String         @id @default(cuid())
  /// Orden total de la cadena (lo asigna el trigger bajo un lock).
  seq              BigInt         @unique @default(autoincrement())
  createdAt        DateTime       @default(now())
  action           AuditAction
  outcome          AuditOutcome   @default(SUCCESS)
  actorType        AuditActorType
  actorUserId      String?
  /// Paciente cuyos datos se vieron afectados (alimenta "Actividad de mi cuenta").
  subjectPatientId String?
  resourceType     String?
  resourceId       String?
  grantId          String?
  /// IP anonimizada.
  ip               String?
  userAgent        String?
  /// Metadatos no sensibles (lista blanca de claves; ver src/server/audit/log.ts).
  metadata         Json?
  prevHash         String?
  hash             String?

  @@index([subjectPatientId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 del token enviado por email.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Códigos de recuperación de MFA (un solo uso, guardados como hash).
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// ─────────────────────────────────────────────────────────────────────────────
// FASE 6 — Procesamiento de estudios y mediciones longitudinales
//
// El archivo original (MedicalFile + storage) es la fuente primaria y NUNCA se modifica
// (trigger medical_files_immutable). Todo lo que se extrae vive aparte y es revisable.
// ─────────────────────────────────────────────────────────────────────────────

enum DocumentProcessingStatus {
  UPLOADED
  PROCESSING
  READY_FOR_REVIEW
  CONFIRMED
  FAILED
}

enum ExtractionMethod {
  /// Texto embebido en el PDF.
  PDF_TEXT
  /// Reconocimiento óptico de caracteres (foto o PDF escaneado).
  OCR
  /// Cargado o corregido a mano.
  MANUAL
}

enum MeasurementReviewStatus {
  PENDING
  CONFIRMED
  DISCARDED
}

/// Resultado del análisis automático de UN archivo. Nunca reemplaza al original.
model DocumentExtraction {
  id               String                   @id @default(cuid())
  patientId        String
  recordId         String
  fileId           String                   @unique
  status           DocumentProcessingStatus @default(UPLOADED)
  method           ExtractionMethod?
  /// Proveedor y versión que produjo el texto (p. ej. "unpdf", "tesseract.js/spa").
  provider         String?
  /// Texto extraído (para búsqueda y revisión). El documento original sigue siendo la fuente.
  text             String?
  pageCount        Int?
  /// Confianza media del OCR (0–100), si se usó.
  ocrConfidence    Float?
  /// Metadatos propuestos (título, fecha, tipo, institución…) con su confianza. Ver DocumentSuggestions.
  suggestions      Json?
  /// true si el paciente ya completó o confirmó los datos del estudio.
  metadataReviewed Boolean                  @default(false)
  /// Código de error interno (sin datos del paciente) si status = FAILED.
  errorCode        String?
  attempts         Int                      @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  patient      PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  record       MedicalRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  file         MedicalFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  reviewedBy   User?                @relation("ExtractionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  measurements MedicalMeasurement[]

  @@index([patientId, status])
  @@index([recordId])
  @@map("document_extractions")
}

/// Catálogo de conceptos normalizados (glucemia, colesterol HDL…). Extensible y preparado
/// para mapearse a LOINC / SNOMED CT (códigos vacíos hasta validarlos).
model MeasurementConcept {
  id          String   @id @default(cuid())
  /// Clave estable interna (p. ej. "glucose").
  code        String   @unique
  displayName String
  /// Sinónimos normalizados (minúsculas, sin acentos): "glucemia", "glucosa", "glucose".
  aliases     String[] @default([])
  defaultUnit String?
  loincCode   String?
  snomedCode  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  measurements MedicalMeasurement[]

  @@map("measurement_concepts")
}

/// Un valor medido (p. ej. Glucemia 92 mg/dL) con su procedencia completa.
model MedicalMeasurement {
  id               String                  @id @default(cuid())
  patientId        String
  /// Documento (registro) del que proviene. Define la categoría y, por lo tanto, quién puede verlo.
  recordId         String
  fileId           String?
  extractionId     String?
  conceptId        String?
  /// Nombre tal como figura en el documento. Nunca se modifica.
  originalName     String
  /// Clave de agrupación: código del concepto o, si no se reconoce, el nombre normalizado.
  normalizedKey    String
  /// Valor tal como figura ("14,8", "<0,5", "Negativo").
  valueText        String
  valueNumeric     Decimal?                @db.Decimal(18, 6)
  unit             String?
  refLow           Decimal?                @db.Decimal(18, 6)
  refHigh          Decimal?                @db.Decimal(18, 6)
  /// Referencia textual original ("70 - 100 mg/dL", "< 200").
  refText          String?
  /// Indicador de fuera de rango impreso en el documento ("H", "*", "Alto"…), si lo hay.
  documentFlag     String?
  measuredOn       DateTime                @db.Date
  institutionId    String?
  extractionMethod ExtractionMethod
  /// 0–1. Estimación de qué tan segura es la extracción automática.
  confidence       Float?
  reviewStatus     MeasurementReviewStatus @default(PENDING)
  /// Valores detectados originalmente, para mostrar qué se corrigió.
  detected         Json?
  editedAt         DateTime?
  confirmedById    String?
  confirmedAt      DateTime?
  /// Verificación opcional por un profesional (preparado para fases futuras).
  verifiedById     String?
  verifiedAt       DateTime?
  source           DataSource              @default(SYSTEM)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  patient     PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  record      MedicalRecord       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  file        MedicalFile?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  extraction  DocumentExtraction? @relation(fields: [extractionId], references: [id], onDelete: SetNull)
  concept     MeasurementConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  institution Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  confirmedBy User?               @relation("MeasurementConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  verifiedBy  User?               @relation("MeasurementVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([patientId, normalizedKey, measuredOn])
  @@index([patientId, reviewStatus])
  @@index([recordId])
  @@map("medical_measurements")
}
