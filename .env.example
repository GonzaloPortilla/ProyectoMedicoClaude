# Copiá este archivo a `.env` y completá los valores. Nunca subas `.env` al repositorio.

# Conexión a PostgreSQL
DATABASE_URL="postgresql://medapp:CAMBIAR_PASSWORD@localhost:5432/medapp?schema=public"

# Base de datos separada para tests de integración (opcional; si no está, se omiten)
TEST_DATABASE_URL="postgresql://medapp:CAMBIAR_PASSWORD@localhost:5432/medapp_test?schema=public"

# URL pública de la app (se usa para armar links de recuperación de contraseña)
APP_URL="http://localhost:3000"

# Envío de emails: "console" imprime los mensajes en la consola del servidor (desarrollo).
# En producción, si no se define, los emails no se envían hasta configurar un proveedor real.
MAIL_TRANSPORT="console"

# Contraseña usada por `npm run db:seed` para las cuentas demo (sólo desarrollo)
SEED_DEMO_PASSWORD="CAMBIAR_password_demo"
