# Copiá este archivo a `.env`. Nunca subas `.env` al repositorio.
#   macOS / Linux:        cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#
# Los valores de abajo funcionan tal cual con `docker compose up -d` (PostgreSQL local de desarrollo).
# Si usás tu propio PostgreSQL, cambiá usuario y contraseña. En producción usá secretos propios.

# Conexión a PostgreSQL
DATABASE_URL="postgresql://medapp:medapp_dev_password@localhost:5432/medapp?schema=public"

# Base de datos separada para tests de integración (opcional; si no está, se omiten)
TEST_DATABASE_URL="postgresql://medapp:medapp_dev_password@localhost:5432/medapp_test?schema=public"

# URL pública de la app (se usa para armar links de recuperación de contraseña)
APP_URL="http://localhost:3000"

# Secreto del servidor (≥ 32 caracteres). Firma los enlaces temporales de archivos y cifra
# los secretos de la verificación en dos pasos. En producción es OBLIGATORIO y propio:
#   openssl rand -base64 48
# (en desarrollo, si se omite, se usa uno de ejemplo; la app se niega a usarlo en producción).
APP_SECRET="dev-only-insecure-secret-change-me-0123456789abcdef"

# Roles que deben usar verificación en dos pasos (separados por coma). Por defecto, en
# producción: ADMIN. En desarrollo, ninguno (para poder probar las cuentas demo sin teléfono).
# MFA_REQUIRED_ROLES="ADMIN,DOCTOR"

# Envío de emails: "console" imprime los mensajes en la consola del servidor (desarrollo).
# En producción, si no se define, los emails no se envían hasta configurar un proveedor real.
MAIL_TRANSPORT="console"

# Almacenamiento de documentos médicos (siempre privado, nunca con URL pública).
#   local → carpeta en disco fuera de /public (sólo desarrollo / un único servidor)
#   s3    → object storage compatible con S3 (AWS S3, Cloudflare R2, MinIO…) con bucket PRIVADO
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/private"
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""            # sólo para proveedores no-AWS (R2, MinIO)
# S3_FORCE_PATH_STYLE="false"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Análisis automático de estudios (Fase 6). Todo corre localmente: ningún documento sale del servidor.
#   DOCUMENT_EXTRACTION = "local" (por defecto) | "disabled"
#   OCR_PROVIDER        = "tesseract" (por defecto, OCR local en español) | "none"
#   OCR_MAX_PAGES       = páginas de un PDF escaneado que se leen con OCR (por defecto 3)
# DOCUMENT_EXTRACTION="local"
# OCR_PROVIDER="tesseract"
# OCR_MAX_PAGES="3"

# Contraseña usada por `npm run db:seed` para las cuentas demo (sólo desarrollo)
SEED_DEMO_PASSWORD="Demo1234!"
